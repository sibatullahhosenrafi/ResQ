<?xml version="1.0" encoding="utf-8"?>
<!-- At least 720dp wide (most phones sideways, 8-inch tablets): lists switch to 2 columns.
     Android picks the folder by the width the screen has RIGHT NOW, so rotating changes it. -->
<resources>
    <dimen name="content_h_padding">72dp</dimen>
    <dimen name="numbers_h_padding">68dp</dimen>
    <dimen name="auth_h_padding">76dp</dimen>
    <dimen name="list_h_padding">56dp</dimen>
    <dimen name="chat_h_padding">48dp</dimen>
    <dimen name="header_h_padding">60dp</dimen>
    <dimen name="item_h_margin">6dp</dimen>
    <integer name="list_columns">2</integer>
    <integer name="grid_columns">3</integer>
</resources>
