<?xml version="1.0" encoding="utf-8"?>
<!-- ResQ Safety Panel (home-screen widget). Only views that RemoteViews allows are used. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_calm"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left: the big SOS button with two soft rings -->
    <FrameLayout
        android:id="@+id/w_sos"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:contentDescription="@string/widget_sos_desc">

        <FrameLayout
            android:id="@+id/w_ring_outer"
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:background="@drawable/bg_sos_ring_outer">

            <FrameLayout
                android:id="@+id/w_ring_inner"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_sos_ring_inner">

                <TextView
                    android:id="@+id/w_sos_text"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_sos_btn"
                    android:gravity="center"
                    android:text="@string/widget_sos"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- Right: header + 2 x 2 quick actions -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_resq_logo" />

            <TextView
                android:id="@+id/w_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/widget_title"
                android:textColor="#1F1A1B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_ready"
                android:textColor="#7B6F72"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/w_tile_siren"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_calm"
                android:contentDescription="@string/widget_siren_desc"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/w_ic_siren"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_siren_on" />

                <TextView
                    android:id="@+id/w_tv_siren"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_siren"
                    android:textColor="#1F1A1B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_tile_hosp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_calm"
                android:contentDescription="@string/widget_hospital_desc"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/w_ic_hosp"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_local_hospital" />

                <TextView
                    android:id="@+id/w_tv_hosp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_hospital"
                    android:textColor="#1F1A1B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/w_tile_call"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_calm"
                android:contentDescription="@string/widget_call_desc"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/w_ic_call"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_helpline" />

                <TextView
                    android:id="@+id/w_tv_call"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_call"
                    android:textColor="#1F1A1B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/w_tile_aid"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_tile_calm"
                android:contentDescription="@string/widget_aid_desc"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:id="@+id/w_ic_aid"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_medical" />

                <TextView
                    android:id="@+id/w_tv_aid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_aid"
                    android:textColor="#1F1A1B"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
