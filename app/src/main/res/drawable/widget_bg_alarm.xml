<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background while the siren is ON: the whole widget turns crimson -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#F0525F"
        android:endColor="#B3122A"
        android:type="linear" />
    <corners android:radius="26dp" />
</shape>
