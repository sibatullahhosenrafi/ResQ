<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background, normal state: soft white to pink card with a pink hairline -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#FFFFFF"
        android:endColor="#FDEDEF"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#F4D3D7" />
    <corners android:radius="26dp" />
</shape>
