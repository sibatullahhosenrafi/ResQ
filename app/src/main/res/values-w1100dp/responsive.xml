    <dimen name="numbers_h_padding">256dp</dimen>
    <dimen name="auth_h_padding">264dp</dimen>
    <dimen name="list_h_padding">244dp</dimen>
    <dimen name="chat_h_padding">236dp</dimen>
    <dimen name="header_h_padding">248dp</dimen>
    <dimen name="item_h_margin">6dp</dimen>
    <integer name="list_columns">2</integer>
    <integer name="grid_columns">4</integer>
</resources>
