<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: crimson UI kit look -->
    <style name="Theme.ResQ" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_light</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- dialogs / sheets use this; equals the default white in light mode -->
        <item name="colorSurface">@color/surface</item>

        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/background_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_status_bar</item>

        <item name="materialButtonStyle">@style/Widget.ResQ.Button</item>
        <item name="textInputStyle">@style/Widget.ResQ.TextInput</item>
        <item name="materialCardViewStyle">@style/Widget.ResQ.Card</item>
    </style>

    <!-- Pill buttons -->
    <style name="Widget.ResQ.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/brand_primary</item>
    </style>

    <style name="Widget.ResQ.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/brand_accent</item>
        <item name="strokeColor">@color/brand_accent</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/pink_card</item>
    </style>

    <style name="Widget.ResQ.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/brand_accent</item>
        <item name="rippleColor">@color/pink_card</item>
    </style>

    <!-- Home screen category tile -->
    <style name="Widget.ResQ.Tile" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">22dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">104dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:maxLines">2</item>
        <item name="iconSize">30dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">top</item>
    </style>

    <!-- Rounded inputs -->
    <style name="Widget.ResQ.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/brand_accent</item>
    </style>

    <style name="Widget.ResQ.TextInput.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/brand_accent</item>
    </style>

    <!-- Soft white cards with a pink hairline -->
    <style name="Widget.ResQ.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/pink_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Emergency type chips -->
    <style name="Widget.ResQ.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/pink_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="chipIconSize">18dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">true</item>
        <item name="rippleColor">@color/pink_card</item>
    </style>
</resources>
